# DetoxRAG configuration. Copy to .env and adjust as needed.
# All paths are relative to the project root unless absolute.

# --- Models (local directories; downloaded from Hugging Face) ---
DETOX_LLM_PATH=models/qwen3-4b-mlx-4bit
DETOX_EMBEDDING_PATH=models/qwen3-embedding-0.6b
# Device for the embedding model: mps (Apple GPU) or cpu
DETOX_EMBEDDING_DEVICE=mps
DETOX_EMBEDDING_BATCH_SIZE=8

# --- Generation ---
DETOX_LLM_MAX_TOKENS=1024
DETOX_LLM_TEMPERATURE=0.0

# --- Data ---
DETOX_GUIDELINES_DIR=data/guidelines
DETOX_PROCESSED_DIR=data/processed
DETOX_VECTOR_STORE_DIR=data/vector_store
DETOX_DATABASE_PATH=data/synthetic_patients/detoxrag.db

# --- Chunking ---
DETOX_CHUNK_MAX_WORDS=220
DETOX_CHUNK_OVERLAP_WORDS=40

# --- Retrieval ---
DETOX_RETRIEVAL_TOP_K=5
DETOX_RETRIEVAL_CANDIDATES=20
DETOX_RRF_K=60
# Hybrid search returns nothing if no passage reaches this cosine similarity
# (off-topic query gate). Heuristic value; leave empty to disable.
DETOX_RETRIEVAL_MIN_DENSE_SIM=0.5

# --- Timeline analytics (software review settings, NOT clinical standards) ---
# Intervals longer than REVIEW_INTERVAL x GAP_TOLERANCE are flagged for review.
DETOX_REVIEW_INTERVAL_HOURS=4
DETOX_GAP_TOLERANCE=1.5
# Assessments and vital-sign sets within this many minutes count as paired.
DETOX_PAIRING_MINUTES=30
# Notes within this many minutes of a contradicting record are flagged.
DETOX_CONFLICT_MINUTES=60

# Keep Hugging Face libraries offline once models are downloaded
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
